# API
PORT=4000
WEB_ORIGIN=http://localhost:3000

# MongoDB connection string. Use a local MongoDB instance or a free MongoDB Atlas cluster.
MONGODB_URI=mongodb://127.0.0.1:27017/ai-interview-prep

